{
    "name": "myui5app",
    "version": "0.0.1",
    "description": "myui5app description",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "main": "webapp/index.html",
    "devDependencies": {
        "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
        "@sap/ux-ui5-tooling": "^1.32.0",
        "@ui5/cli": "^4.0.33",
        "@ui5/linter": "latest",
        "eslint": "^10"
    },
    "scripts": {
        "start": "fiori run --open index.html",
        "build": "ui5 build --config=ui5.yaml --clean-dest --dest ../dist/myui5app",
        "lint": "eslint ./",
        "start-variants-management": "fiori run --open \"/preview.html?sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#myui5app-display\"",
        "ui5lint": "ui5lint"
    }
}
