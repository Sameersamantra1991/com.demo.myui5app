<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="productDialog"
        title="Product Details"
        contentWidth="400px"
        stretchOnPhone="true">

        <content>
            <VBox class="sapUiMediumMargin" gap="8px">

                <Label text="ID" />
                <Text text="{selectedProduct>/id}" />

                <Label text="Name" />
                <Text text="{selectedProduct>/name}" />

                <Label text="Category" />
                <Text text="{selectedProduct>/category}" />

                <Label text="Price" />
                <Text text="{selectedProduct>/price}" />

            </VBox>
        </content>

        <beginButton>
            <Button
                text="Close"
                press=".onCloseProductDialog" />
        </beginButton>

    </Dialog>

</core:FragmentDefinition>