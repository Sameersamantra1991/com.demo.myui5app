<mvc:View controllerName="myui5app.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <content>
            <VBox class="sapUiMediumMargin" gap="8px">
                <Button
                    text="Products (Local JSON)"
                    press=".onProductsPress" />
                <Button
                    text="Sample Products (Northwind OData)"
                    press=".onSampleProductPress" />
                <Button
                    text="OData V2 Demo"
                    press=".onODataV2Press" />
            </VBox>
        </content>
    </Page>
</mvc:View>
