{
    "_version": "1.86.0",
    "sap.app": {
        "id": "myui5app",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "0.0.1"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "@sap-ux/fiori-freestyle-writer:basic",
            "version": "3.0.39"
        },
        "dataSources": {
            "mainService": {
                "uri": "/V4/TripPinServiceRW/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }

    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.148.3",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "products": {
                "type": "sap.ui.model.json.JSONModel",
                "uri": "model/products.json"
            },
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "myui5app.i18n.i18n"
                }
            },

            
            "": {
            "dataSource": "mainService",
            "preload": true,
            "settings": {
                "operationMode": "Server",
                "autoExpandSelect": true
            }
        }
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "controlAggregation": "pages",
                "controlId": "app",
                "transition": "slide",
                "type": "View",
                "viewType": "XML",
                "path": "myui5app.view",
                "async": true,
                "viewPath": "myui5app.view",
                "bypassed": {
                    "target": "TargetNotFound"
                }
            },
            "routes": [
                {
                    "name": "RouteMainView",
                    "pattern": "",
                    "target": "TargetMainView"
                },
                {
                    "name": "RouteViewProduct",
                    "pattern": "products",
                    "target": "TargetViewProduct"
                },
                {
                    "pattern": "people",
                    "name": "people",
                    "target": "people"
                },
                {
                    "pattern": "oDataV2",
                    "name": "oDataV2",
                    "target": "oDataV2Target"
                },
                {
                    "pattern": "sampleProduct",
                    "name": "sampleProduct",
                    "target": "sampleProduct"
                },
                {
                    "name": "NotFound",
                    "pattern": ":all*:",
                    "target": "TargetNotFound"
                }
            ],
            "targets": {
                "TargetMainView": {
                    "id": "MainView",
                    "name": "MainView"
                },
                "TargetViewProduct": {
                    "id": "ViewProduct",
                    "name": "ViewProduct"
                },
                "people": {
                    "viewName": "ViewOdataService",
                    "viewType": "XML",
                    "viewLevel": 2
                },
                "sampleProduct": {
                    "viewName": "sampleProduct",
                    "viewType": "XML",
                    "viewLevel": 2
                },
                "oDataV2Target": {
                    "viewName": "oDataV2",
                    "viewType": "XML",
                    "viewLevel": 2
                },
                "TargetNotFound": {
                    "id": "NotFound",
                    "name": "NotFound"
                }
            }
        },
        "rootView": {
            "viewName": "myui5app.view.App",
            "type": "XML",
            "id": "App",
            "async": true
        }
    }
}